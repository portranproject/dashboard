# 복사해서 사용: cp .env.example .env
# .env는 커밋하지 않는다.

# --- InfluxDB 2.x ---
INFLUX_PORT=8086
# 호스트에서 실행하는 Python 프로그램(collector, evaluator)이 접속할 주소
INFLUX_URL=http://localhost:8086
INFLUX_ORG=portran
INFLUX_BUCKET=portran
# 최초 기동 시 관리자 토큰으로 등록된다. 예: openssl rand -hex 32
INFLUX_TOKEN=change-me-dev-token
INFLUX_ADMIN_USER=admin
# 8자 이상
INFLUX_ADMIN_PASSWORD=change-me-password

# --- Grafana ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-password

# --- collector ---
# .env에 없는 키는 이 파일의 값이 쓰인다.
COLLECTOR_UDP_HOST=127.0.0.1
COLLECTOR_UDP_PORT=9999
# InfluxDB에 이 건수가 모이거나 이 시간이 지나면 한 번에 쓴다
COLLECTOR_BATCH_SIZE=500
COLLECTOR_FLUSH_INTERVAL_MS=1000
# InfluxDB 장애 시 메모리에 들고 있을 최대 건수 (넘으면 오래된 것부터 버림. raw 녹화에는 남음)
COLLECTOR_MAX_PENDING=100000
COLLECTOR_INFLUX_TIMEOUT_MS=5000
# UDP 수신 버퍼 요청 크기. 실제 크기는 OS 상한(net.core.rmem_max)에 막힐 수 있음
COLLECTOR_UDP_RCVBUF_BYTES=4194304
# 파일 입력에서 새 줄을 확인하는 주기
COLLECTOR_FILE_POLL_MS=200
RECORDINGS_DIR=recordings
