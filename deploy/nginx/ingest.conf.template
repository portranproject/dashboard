# 탐지 엔진 전송기 → /ingest 앞단 (M9, docs/deploy.md 10절).
# TLS는 여기서 끝내고 collector에는 compose 네트워크 안에서 평문 HTTP로 넘긴다(collector 포트는 호스트에 열지 않음).
# nginx 공식 이미지가 기동할 때 ${COLLECTOR_HTTP_PORT}·${COLLECTOR_HTTP_MAX_BYTES}를 환경변수로 채운다(envsubst).
# 약속(응답 코드·크기)은 reference/detection/27_ §3, schema/SCHEMA.md 2절.

server {
    listen 443 ssl;
    server_tokens off;

    # 자체 서명 인증서(이름 = 대시보드 공인 IP). deploy/ingest-cert.sh가 만든다
    ssl_certificate     /etc/nginx/certs/ingest.crt;
    ssl_certificate_key /etc/nginx/certs/ingest.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # 요청 하나 최대 크기. 넘으면 nginx가 413 → 전송기가 반으로 나눠 다시 보낸다
    client_max_body_size    ${COLLECTOR_HTTP_MAX_BYTES};
    client_body_buffer_size ${COLLECTOR_HTTP_MAX_BYTES};

    # collector 주소를 요청마다 Docker DNS로 찾는다. 배포로 collector 컨테이너가 다시 만들어져 IP가 바뀌어도 따라간다
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $collector http://collector:${COLLECTOR_HTTP_PORT};

    # collector가 재시작 중이거나(502) 늦으면(504) 503으로 바꿔 답한다.
    # 전송기는 503이면 간격을 늘려 다시 보내지만, 502·504 같은 그 밖의 코드는 설정 문제로 보고 전송을 멈춘다(27_ §3)
    error_page 502 504 =503 @unavailable;
    location @unavailable {
        default_type application/json;
        return 503 '{"error":"collector에 연결할 수 없습니다. 잠시 뒤 다시 보내세요"}';
    }

    location = /ingest {
        proxy_pass $collector;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        # collector는 같은 서버 안이라 연결은 금방 된다. 저장을 마친 뒤 답하므로 응답은 최대 COLLECTOR_HTTP_TIMEOUT_MS(30초)
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location = /healthz {
        proxy_pass $collector;
        proxy_connect_timeout 5s;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    location / {
        default_type application/json;
        return 404 '{"error":"없는 경로입니다 (POST /ingest)"}';
    }
}
