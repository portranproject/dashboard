                  "color": "text",
                  "index": 3
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "평가 구간",
      "description": "evaluator의 --from / --to. 지연 히스토그램과 오버헤드 비교는 이 구간의 데이터를 쓴다",
      "datasource": {
        "type": "influxdb",
        "uid": "portran-influxdb"
      },
      "gridPos": {
        "h": 4,
        "w": 10,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "portran-influxdb"
          },
          "refId": "A",
          "query": "import \"array\"\nimport \"date\"\nsel = from(bucket: v.defaultBucket)\n  |> range(start: -365d)\n  |> filter(fn: (r) => r._measurement == \"eval_result\" and (r._field == \"eval_id\" or r._field == \"window_from\" or r._field == \"window_to\"))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => r.eval_id == \"${eval_id}\")\n  |> group()\n  |> findRecord(fn: (key) => true, idx: 0)\nw_from = if exists sel.window_from then time(v: sel.window_from) else date.sub(d: 1s, from: now())\nw_to = if exists sel.window_to then time(v: sel.window_to) else now()\narray.from(rows: [{_time: now(), _field: \"시작\", _value: float(v: int(v: w_from)) / 1000000.0},\n                  {_time: now(), _field: \"끝\", _value: float(v: int(v: w_to)) / 1000000.0}])\n  |> group(columns: [\"_field\"])"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "공격 run 수 · grace",
      "description": "평가 구간 안에서 시작한 공격(attack_run) 수와, 공격 종료 후 탐지를 인정한 시간",
      "datasource": {
        "type": "influxdb",
        "uid": "portran-influxdb"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "portran-influxdb"
          },
          "refId": "A",
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -365d)\n  |> filter(fn: (r) => r._measurement == \"eval_result\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => r.eval_id == \"${eval_id}\")\n  |> group()\n  |> filter(fn: (r) => r.ruleset == \"full\")\n  |> reduce(identity: {runs: 0, grace: 0.0}, fn: (r, accumulator) => ({runs: accumulator.runs + r.runs, grace: r.grace_sec}))\n  |> map(fn: (r) => ({\"공격 run\": r.runs, \"grace (초)\": r.grace}))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
