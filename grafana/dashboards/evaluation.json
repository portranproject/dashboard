    {
      "id": 10,
      "type": "table",
      "title": "시나리오 × 룰셋",
      "datasource": {
        "type": "influxdb",
        "uid": "portran-influxdb"
      },
      "description": "탐지율 = TP / run, precision = 매칭된 탐지 / 전체 탐지. 빈칸은 분모가 0이라 계산할 수 없는 값. 오탐/시간은 evaluator 리포트(reports/eval-*.md)에 있다",
      "gridPos": {
        "h": 7,
        "w": 16,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "portran-influxdb"
          },
          "refId": "A",
          "query": "base = from(bucket: v.defaultBucket)\n  |> range(start: -365d)\n  |> filter(fn: (r) => r._measurement == \"eval_result\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => r.eval_id == \"${eval_id}\")\n  |> group()\npick = (ruleset, prefix) => base\n  |> filter(fn: (r) => r.ruleset == ruleset)\n  |> map(fn: (r) => ({scenario: r.scenario, runs: r.runs,\n      rate: r.detection_rate, precision: r.precision, fp: r.fp_count, fph: r.fp_per_hour}))\nfull = pick(ruleset: \"full\", prefix: \"full\")\nkpm = pick(ruleset: \"kpm_only\", prefix: \"kpm\")\njoin(tables: {full: full, kpm: kpm}, on: [\"scenario\", \"runs\"])\n  |> sort(columns: [\"scenario\"])"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "scenario": 0,
              "runs": 1,
              "rate_full": 2,
              "rate_kpm": 3,
              "precision_full": 4,
              "precision_kpm": 5,
              "fp_full": 6,
              "fp_kpm": 7,
              "fph_full": 8,
              "fph_kpm": 9
            },
            "renameByName": {
              "scenario": "시나리오",
              "runs": "run",
              "rate_full": "탐지율 full",
              "rate_kpm": "탐지율 kpm_only",
              "precision_full": "precision full",
              "precision_kpm": "precision kpm_only",
              "fp_full": "오탐 full",
              "fp_kpm": "오탐 kpm_only",
              "fph_full": "오탐/시간 full",
              "fph_kpm": "오탐/시간 kpm_only"
            },
            "excludeByName": {
              "fph_full": true,
              "fph_kpm": true
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "wrapHeaderText": true,
            "width": 105,
            "minWidth": 60
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(탐지율|precision) .*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-RdYlGr"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^오탐/시간 .*"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "시나리오"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 185
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "run"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 45
              }
            ]
          }
        ]
      }
