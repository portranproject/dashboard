    {
      "id": 1,
      "type": "stat",
      "title": "데이터 출처",
      "description": "mock이면 mock 생성기가 정한 탐지율·지연을 다시 계산한 것이라 성능 결과가 아니다 (CLAUDE.md 12절 7항)",
      "datasource": {
        "type": "influxdb",
        "uid": "portran-influxdb"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "portran-influxdb"
          },
          "refId": "A",
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -365d)\n  |> filter(fn: (r) => r._measurement == \"eval_result\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => r.eval_id == \"${eval_id}\")\n  |> group()\n  |> last(column: \"data_source\")\n  |> keep(columns: [\"data_source\"])"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
