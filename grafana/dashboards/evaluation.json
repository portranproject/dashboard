          "query": "import \"date\"\nsel = from(bucket: v.defaultBucket)\n  |> range(start: -365d)\n  |> filter(fn: (r) => r._measurement == \"eval_result\" and (r._field == \"eval_id\" or r._field == \"window_from\" or r._field == \"window_to\"))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => r.eval_id == \"${eval_id}\")\n  |> group()\n  |> findRecord(fn: (key) => true, idx: 0)\nw_from = if exists sel.window_from then time(v: sel.window_from) else date.sub(d: 1s, from: now())\nw_to = if exists sel.window_to then time(v: sel.window_to) else now()\nfrom(bucket: v.defaultBucket)\n  |> range(start: w_from, stop: w_to)\n  |> filter(fn: (r) => r._measurement == \"overhead\" and r._field == \"cpu_pct\")\n  |> group(columns: [\"node\", \"ebpf_on\"])\n  |> mean()\n  |> map(fn: (r) => ({node: r.node, mode: if r.ebpf_on == \"true\" then \"eBPF on\" else \"eBPF off\", _value: r._value}))\n  |> group()\n  |> pivot(rowKey: [\"node\"], columnKey: [\"mode\"], valueColumn: \"_value\")\n  |> sort(columns: [\"node\"])"
