                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "평가 없음 — python -m evaluator.evaluate 실행",
          "mappings": [
            {
              "type": "value",
              "options": {
                "mock": {
                  "text": "mock — 성능 결과 아님",
                  "color": "red",
                  "index": 0
                },
                "replay": {
                  "text": "replay (녹화 재생)",
                  "color": "orange",
