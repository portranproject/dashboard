      {
        "name": "공격 구간 (attack_run)",
        "datasource": {
          "type": "influxdb",
          "uid": "portran-influxdb"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(255, 152, 48, 0.55)",
        "target": {
          "datasource": {
            "type": "influxdb",
            "uid": "portran-influxdb"
          },
          "refId": "Anno",
          "query": "import \"date\"\nfrom(bucket: v.defaultBucket)\n  |> range(start: date.sub(d: 1h, from: v.timeRangeStart), stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"attack_run\")\n  |> filter(fn: (r) => contains(value: r.scenario, set: ${attack_type:json}))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> map(fn: (r) => ({_time: r._time, timeEnd: time(v: r.ts_end), text: \"공격 \" + r.scenario + \" (\" + r.run_id + \")\", tags: r.scenario}))"
        },
        "mappings": {
          "time": {
            "source": "field",
            "value": "_time"
          },
          "timeEnd": {
            "source": "field",
            "value": "timeEnd"
          },
          "text": {
            "source": "field",
            "value": "text"
          },
          "tags": {
            "source": "field",
            "value": "tags"
          }
        },
        "filter": {
          "exclude": false,
          "ids": [
            10,
            11
          ]
        }
      },
      {
        "name": "탐지 (detection)",
        "datasource": {
          "type": "influxdb",
          "uid": "portran-influxdb"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "target": {
          "datasource": {
            "type": "influxdb",
            "uid": "portran-influxdb"
          },
          "refId": "Anno",
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"detection\" and r._field == \"event_id\")\n  |> filter(fn: (r) => r.ruleset == \"${ruleset}\" and contains(value: r.node, set: ${node:json}) and contains(value: r.attack_type, set: ${attack_type:json}))\n  |> group()\n  |> map(fn: (r) => ({_time: r._time, text: r.attack_type + \" · \" + r.severity + \" · \" + r.rule_id + \" · \" + r._value, tags: r.severity}))"
        },
        "mappings": {
          "time": {
            "source": "field",
            "value": "_time"
          },
          "text": {
            "source": "field",
            "value": "text"
          },
          "tags": {
            "source": "field",
            "value": "tags"
          }
        },
        "filter": {
          "exclude": false,
          "ids": [
            10,
            11
          ]
        }
      }
    ]
  },
