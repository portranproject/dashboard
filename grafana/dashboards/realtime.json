        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "portran-influxdb"
        },
        "description": "근거 표에 보여 줄 탐지 이벤트 (최신순)",
        "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"detection\" and r._field == \"event_id\")\n  |> filter(fn: (r) => r.ruleset == \"${ruleset}\" and contains(value: r.node, set: ${node:json}) and contains(value: r.attack_type, set: ${attack_type:json}))\n  |> group()\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 100)\n  |> keep(columns: [\"_value\"])",
        "definition": "detection event_id (최신순)",
        "refresh": 2,
        "sort": 0,
        "multi": false,
        "includeAll": false
      }
    ]
  },
