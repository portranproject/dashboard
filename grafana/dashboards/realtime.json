    {
      "id": 30,
      "type": "table",
      "title": "근거 — ${event_id}",
      "datasource": {
        "type": "influxdb",
        "uid": "portran-influxdb"
      },
      "description": "위 변수 event_id(또는 이벤트 표의 event_id 링크)로 고른 탐지 이벤트의 evidence. evidence_json을 Extract fields로 펼친다",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "portran-influxdb"
          },
          "refId": "A",
          "query": "import \"array\"\nimport \"experimental/dynamic\"\nev = from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"detection\" and (r._field == \"event_id\" or r._field == \"evidence_json\"))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => r.event_id == \"${event_id}\")\n  |> group()\n  |> findColumn(fn: (key) => true, column: \"evidence_json\")\n// evidence 배열을 항목마다 한 행(JSON 문자열)으로 나눈다. 열로 펼치는 건 Grafana Extract fields 변환\nrows = if length(arr: ev) > 0\n  then array.map(arr: dynamic.asArray(v: dynamic.jsonParse(data: bytes(v: ev[0]))), fn: (x) => ({evidence: string(v: dynamic.jsonEncode(v: x))}))\n  else [{evidence: \"{}\"}]\narray.from(rows: rows)"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "evidence",
            "format": "json",
            "replace": true,
            "keepTime": false
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "source": 0,
              "metric": 1,
              "value": 2,
              "op": 3,
              "threshold": 4,
              "window_ms": 5
            },
            "renameByName": {
              "source": "출처",
              "metric": "지표",
              "value": "값",
              "op": "연산자",
              "threshold": "임계값",
              "window_ms": "윈도우(ms)"
            },
            "excludeByName": {}
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
