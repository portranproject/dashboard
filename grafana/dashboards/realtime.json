          "query": "import \"strings\"\nfrom(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"detection\")\n  |> filter(fn: (r) => r.ruleset == \"${ruleset}\" and contains(value: r.node, set: ${node:json}) and contains(value: r.attack_type, set: ${attack_type:json}))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> map(fn: (r) => ({\n      time: r._time,\n      attack_type: r.attack_type,\n      severity: r.severity,\n      target: r.node + (if exists r.cell then \" · cell \" + r.cell else \"\")\n        + (if r.ue_list != \"[]\" then \" · \" + strings.replaceAll(v: strings.replaceAll(v: strings.trim(v: r.ue_list, cutset: \"[]\"), t: \"\\\"\", u: \"\"), t: \",\", u: \", \") else \"\"),\n      rule_id: r.rule_id,\n      ruleset: r.ruleset,\n      latency_ms: r.latency_ms,\n      event_id: r.event_id,\n  }))\n  |> sort(columns: [\"time\"], desc: true)\n  |> limit(n: 200)"
