    {
      "id": 3,
      "type": "stat",
      "title": "수집 상태 (마지막 수신 후 경과)",
      "description": "소스별로 마지막 메시지가 들어온 뒤 지난 시간. 주기적으로 오는 KPM(1초)·오버헤드(5초)는 늦으면 노랑/빨강. eBPF는 UE 절차가 있을 때만 오고, 탐지·공격 기록은 사건이 있을 때만 오므로 색은 참고용.",
      "datasource": {
        "type": "influxdb",
        "uid": "portran-influxdb"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "portran-influxdb"
          },
          "refId": "A",
          "query": "last_age = (name, pred) => from(bucket: v.defaultBucket)\n  |> range(start: -6h)\n  |> filter(fn: pred)\n  |> group()\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, _field: name, _value: float(v: int(v: now()) - int(v: r._time)) / 1000000000.0}))\nunion(tables: [\n  last_age(name: \"eBPF (eKPM)\", pred: (r) => r._measurement == \"metric\" and r._field == \"value\" and r.src == \"ebpf\"),\n  last_age(name: \"KPM\", pred: (r) => r._measurement == \"metric\" and r._field == \"value\" and r.src == \"kpm\"),\n  last_age(name: \"탐지 엔진\", pred: (r) => r._measurement == \"detection\" and r._field == \"event_id\"),\n  last_age(name: \"공격 기록\", pred: (r) => r._measurement == \"attack_run\" and r._field == \"run_id\"),\n  last_age(name: \"오버헤드\", pred: (r) => r._measurement == \"overhead\" and r._field == \"cpu_pct\"),\n])\n  |> group(columns: [\"_field\"])"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "vertical",
        "wideLayout": true,
        "showPercentChange": false
      },
