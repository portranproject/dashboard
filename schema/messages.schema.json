{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portran.local/schema/messages.schema.json",
  "title": "PortRAN observability message",
  "description": "JSON Lines 한 줄 = 메시지 하나. type 필드로 종류를 구분한다. 사람이 읽는 설명은 schema/SCHEMA.md 참고.",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": { "enum": ["metric", "detection", "attack_run", "overhead"] }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "metric" } }, "required": ["type"] },
      "then": { "$ref": "#/$defs/metric" }
    },
    {
      "if": { "properties": { "type": { "const": "detection" } }, "required": ["type"] },
      "then": { "$ref": "#/$defs/detection" }
    },
    {
      "if": { "properties": { "type": { "const": "attack_run" } }, "required": ["type"] },
      "then": { "$ref": "#/$defs/attack_run" }
    },
    {
      "if": { "properties": { "type": { "const": "overhead" } }, "required": ["type"] },
      "then": { "$ref": "#/$defs/overhead" }
    }
  ],
  "$defs": {
    "epoch_ns": {
      "description": "Unix epoch 나노초 정수. 하한(2001-09-09)은 초·밀리초·마이크로초 단위 실수를 잡기 위한 것.",
      "type": "integer",
      "minimum": 1000000000000000000,
      "maximum": 9223372036854775807
    },
    "node": { "enum": ["cu", "du", "core"] },
    "source": { "enum": ["ebpf", "kpm"] },
    "attack_type": {
      "description": "가안 (CLAUDE.md 5.5). detection.attack_type과 attack_run.scenario가 공유한다.",
      "enum": ["RRC_SIGNALING_STORM", "ABNORMAL_UE_ATTACH", "F1AP_MSG_TAMPER"]
    },
    "non_empty_string": { "type": "string", "minLength": 1 },
    "cell_id": { "type": "string", "minLength": 1 },
    "ue_id": {
      "description": "TODO: UE ID 형식 미확정 (예시는 \"0x4601\"). 확정 전까지 비어 있지 않은 문자열만 검사한다.",
      "type": "string",
      "minLength": 1
    },

    "metric": {
      "type": "object",
      "required": ["type", "ts", "src", "node", "kind", "name", "value", "unit"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "metric" },
        "ts": { "$ref": "#/$defs/epoch_ns" },
        "src": { "$ref": "#/$defs/source" },
        "node": { "$ref": "#/$defs/node" },
        "kind": { "enum": ["ekpm", "kpm"] },
        "name": {
          "description": "TODO: 지표 이름은 가안, eBPF 팀과 확정 예정. 형식만 검사한다.",
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.\\-]*$"
        },
        "value": { "type": "number" },
        "unit": { "type": "string" },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cell": { "$ref": "#/$defs/cell_id" },
            "ue": { "$ref": "#/$defs/ue_id" }
          }
        }
      }
    },

    "evidence": {
      "type": "object",
      "required": ["source", "metric", "op", "value", "threshold", "window_ms"],
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "metric": { "$ref": "#/$defs/non_empty_string" },
        "op": { "enum": [">", ">=", "<", "<=", "==", "!="] },
        "value": { "type": "number" },
        "threshold": { "type": "number" },
        "window_ms": { "type": "integer", "minimum": 0 }
      }
    },

    "detection": {
      "type": "object",
      "required": [
        "type", "event_id", "ts_detected", "ts_first_evidence", "attack_type",
        "severity", "ruleset", "rule_id", "rule_version", "target", "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "detection" },
        "event_id": { "$ref": "#/$defs/non_empty_string" },
        "ts_detected": { "$ref": "#/$defs/epoch_ns" },
        "ts_first_evidence": { "$ref": "#/$defs/epoch_ns" },
        "attack_type": { "$ref": "#/$defs/attack_type" },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "ruleset": { "enum": ["full", "kpm_only"] },
        "rule_id": { "$ref": "#/$defs/non_empty_string" },
        "rule_version": { "$ref": "#/$defs/non_empty_string" },
        "target": {
          "type": "object",
          "required": ["node"],
          "additionalProperties": false,
          "properties": {
            "node": { "$ref": "#/$defs/node" },
            "cell": { "$ref": "#/$defs/cell_id" },
            "ue": { "type": "array", "items": { "$ref": "#/$defs/ue_id" } }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },

    "attack_run": {
      "type": "object",
      "required": ["type", "run_id", "scenario", "ts_start", "ts_end", "params"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "attack_run" },
        "run_id": { "$ref": "#/$defs/non_empty_string" },
        "scenario": { "$ref": "#/$defs/attack_type" },
        "ts_start": { "$ref": "#/$defs/epoch_ns" },
        "ts_end": { "$ref": "#/$defs/epoch_ns" },
        "params": { "type": "object" }
      }
    },

    "overhead": {
      "type": "object",
      "required": ["type", "ts", "node", "ebpf_on", "cpu_pct", "mem_mb"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "overhead" },
        "ts": { "$ref": "#/$defs/epoch_ns" },
        "node": { "$ref": "#/$defs/node" },
        "ebpf_on": { "type": "boolean" },
        "cpu_pct": { "type": "number", "minimum": 0 },
        "mem_mb": { "type": "number", "minimum": 0 }
      }
    }
  }
}
